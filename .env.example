# Copy to .env (scripts/ops.ps1 setup does this and fills in random values). Never commit .env.

# Demo admin (admin@signalpost.test) password, at least 12 characters.
SEED_ADMIN_PASSWORD=replace-with-random-value

# Token that lets ops.ps1 switch the demo target between normal, slow and error (failure drills).
DEMO_CONTROL_TOKEN=replace-with-random-value

# ---- Outbound policy: the only hosts monitors may contact ----
# demo-api is the stand-in service on the internal Docker network; example.org is a paused external example.
ALLOWED_HOSTS=demo-api,example.org
# Hosts allowed to resolve to private addresses. Loopback and link-local stay blocked regardless.
ALLOW_PRIVATE_HOSTS=demo-api
ALLOWED_PORTS=80,443,8080

# ---- Optional, off by default ----
# Prometheus metrics at /metrics with "Authorization: Bearer <token>" (at least 24 characters).
# METRICS_TOKEN=
# Incident webhook. Must pass the outbound policy. The demo target verifies signatures at:
# WEBHOOK_URL=http://demo-api:8080/__webhook
# WEBHOOK_SECRET=   (at least 32 characters)

# Raw check retention in days (daily uptime is kept for 400 days).
RETENTION_DAYS=30
